# ==========================================
# LostReturn Web App - Environment Variables
# ==========================================

# 1. Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. MQTT Broker (HiveMQ Cloud - matches firmware)
MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=lostreturn_admin
MQTT_PASSWORD=your_mqtt_password

# 4. AI Verification (Groq SDK) - Optional
GROQ_API_KEY=your_groq_api_key

# 5. Email Notification (SMTP / Resend) - Optional
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
SMTP_FROM="LostReturn" <noreply@lostreturn.me>
ADMIN_EMAIL=your_admin_email@example.com
